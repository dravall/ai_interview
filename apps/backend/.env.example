# Postgres connection string (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interviewer

# OpenAI Realtime API — mints short-lived client secrets + sideband transcript
# capture. Server-only; never expose it to the frontend.
OPENAI_API_KEY=
# Optional Realtime model / voice overrides (defaults: gpt-realtime-2.1-mini / marin)
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=

# OpenRouter — post-interview grading
OPENROUTER_API_KEY=
# Optional OpenRouter model slug (defaults to qwen/qwen3.8-flash)
OPENROUTER_MODEL=

# HTTPS proxy used for the GitHub scrape (scrapers/github.ts)
PROXY_URL=

# Optional GitHub token: raises the GitHub API limit from 60 to 5,000 requests/hour
GITHUB_TOKEN=

# Optional: interviews a single IP can start per 15 minutes (default 5)
INTAKE_RATE_LIMIT=

# Origin allowed to call this API with credentials (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# development | production — affects cookie `secure` flag
NODE_ENV=development

# Set to "none" only when frontend and backend are deployed on different
# top-level domains (forces the session cookie's Secure flag on — needs
# HTTPS). Leave unset for local/same-site dev.
COOKIE_SAMESITE=
