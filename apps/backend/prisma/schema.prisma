// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Interview {
  id                String     @id @default(uuid())
  githubMetadata    Json
  status            InterviewStatus
  score             Int       @default(0)
  conversations     Message[]
  feedback          String?
  ownerId           String?
  // Grading lease: a Grading row whose lease is stale can be re-claimed.
  gradingStartedAt  DateTime?
  gradingAttempts   Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([ownerId])
}

model Message {
  id              String     @id  @default(uuid())
  message         String
  type            MessageType
  interviewId     String
  interview       Interview   @relation(fields: [interviewId], references: [id])
  createdAt       DateTime    @default(now())
  // OpenAI's conversation item id: makes saving a turn idempotent.
  itemId          String?     @unique

  // Every results poll loads an interview's messages in order.
  @@index([interviewId, createdAt])
}

enum MessageType {
  User
  Assistant
}

enum InterviewStatus {
  Pre
  InProgress
  Ended
  Grading
  Done
  Failed
}