{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "OPENAI_API_KEY",
    "OPENAI_KEY",
    "OPENAI_REALTIME_MODEL",
    "OPENAI_REALTIME_VOICE",
    "OPENROUTER_API_KEY",
    "OPENROUTER_MODEL",
    "PROXY_URL",
    "GITHUB_TOKEN",
    "INTAKE_RATE_LIMIT",
    "FRONTEND_ORIGIN",
    "NODE_ENV",
    "COOKIE_SAMESITE",
    "BUN_PUBLIC_BACKEND_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
